{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/pre-commit-secret-scan.mjs",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/wrap-up-check.mjs",
            "timeout": 30
          },
          {
            "type": "command",
            "command": "node .claude/hooks/screenshot-check.mjs",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
